<?xml version="1.0" encoding="utf-8"?>
<!--
    APM SDK backup exclusion rules.
    The event queue must NOT be backed up — events contain PII (post-scrub), may be stale,
    and could cause confusion if restored to a different install. (MOB-05)
    Host apps must merge these rules with their own android:dataExtractionRules / android:fullBackupContent.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="apm_queue/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="apm_queue/"/>
    </device-transfer>
</data-extraction-rules>
